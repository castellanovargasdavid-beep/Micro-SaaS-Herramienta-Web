# ============================================================================
# BriefQuick — Variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# Panel del proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
# ⚠️ Secreta: nunca debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al cliente
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Anthropic (Claude API) --------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (solo para transcribir notas de voz con Whisper) -----------------
# Claude no transcribe audio de forma nativa. https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Stripe -------------------------------------------------------------------
# https://dashboard.stripe.com/apikeys (usa las claves de test mientras desarrollas)
STRIPE_SECRET_KEY=sk_test_...
# Crea dos productos/precios en Stripe → Product catalog:
#   1) "BriefQuick Pro"      → precio recurrente mensual de $12 USD
#   2) "BriefQuick Lifetime" → precio de pago único de $49 USD
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_LTD=price_...
# Se obtiene al crear el endpoint de webhook (ver README → Configurar Stripe)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App ----------------------------------------------------------------------
# URL pública de la app (usada en emails, redirects de Stripe y metadata OG)
NEXT_PUBLIC_APP_URL=http://localhost:3000
